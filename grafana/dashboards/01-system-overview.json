        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 12,
      "title": "Filesystem Usage Table",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "100 - (node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs|erofs|fakeowner|selfowner|virtiofs.*|fuse.*\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs|erofs|fakeowner|selfowner|virtiofs.*|fuse.*\"} * 100)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "exemplar": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "min": 0,
          "max": 100,
          "custom": {
            "cellOptions": {
              "type": "gauge",
              "mode": "gradient"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Used %"
              }
            ]
          }
        ]
      },
      "options": {},
      "transformations": [
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "mountpoint": true,
              "fstype": true,
              "device": true,
              "Value": true
            }
          }
        }
      ]
    }
  ]
}
